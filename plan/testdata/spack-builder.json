"build_gpu"],"ref":"inputs"}},"\"\nservice_module_root=\"",{"src":" inputs.service.module_root ","tree":{"path":["service","module_root"],"ref":"inputs"}},"\"\nservice_concretize_only=\"",{"src":" inputs.service.concretize_only ","tree":{"path":["service","concretize_only"],"ref":"inputs"}},"\"\nservice_use_public_buildcache=\"",{"src":" inputs.service.use_public_buildcache ","tree":{"path":["service","use_public_buildcache"],"ref":"inputs"}},"\"\nservice_build_on=\"",{"src":" inputs.cluster.build_on ","tree":{"path":["cluster","build_on"],"ref":"inputs"}},"\"\nOVERRIDE_TARGET=\"",{"src":" inputs.service.use_overrides \u0026\u0026 inputs.service.override_target || '' ","tree":{"op":"||","x":{"op":"\u0026\u0026","x":{"path":["service","use_overrides"],"ref":"inputs"},"y":{"path":["service","override_target"],"ref":"inputs"}},"y":{"lit":""}}},"\"\nOVERRIDE_FABRIC=\"",{"src":" inputs.service.use_overrides \u0026\u0026 inputs.service.override_fabric || '' ","tree":{"op":"||","x":{"op":"\u0026\u0026","x":{"path":["service","use_overrides"],"ref":"inputs"},"y":{"path":["service","override_fabric"],"ref":"inputs"}},"y":{"lit":""}}},"\"\nOVERRIDE_CUDA_ARCH=\"",{"src":" inputs.service.use_overrides \u0026\u0026 inputs.service.override_cuda_arch || '' ","tree":{"op":"||","x":{"op":"\u0026\u0026","x":{"path":["service","use_overrides"],"ref":"inputs"},"y":{"path":["service","override_cuda_arch"],"ref":"inputs"}},"y":{"lit":""}}},"\"\nEOF\n# Resolved HERE, and deliberately not inside the quoted heredoc above.\n# Each submitted job runs in its OWN directory under this one, so a\n# ${PWD}-relative value would expand differently in every job that\n# sources inputs.sh: detect would write fabric.env into detect/ and the\n# build would look for it in build/, and app_dir would point at a\n# checkout that only exists here. That is exactly how run thorough-oryx\n# failed with \"No fabric profile at .../build/fabric.env\".\ncat \u003c\u003cEOF \u003e\u003e inputs.sh\napp_dir=\"${PWD}/workflows/spack-builder/app\"\nfabric_env=\"${PWD}/fabric.env\"\nenv_dir=\"${PWD}/spack-env\"\nmodulepath_env=\"${PWD}/modulepath.env\"\nexternals_head=\"${PWD}/externals.head.yaml\"\nexternals_compute=\"${PWD}/externals.compute.yaml\"\nEOF\n# Remove empty variables\nsed -i '/=\\s*$\\|=undefined\\s*$/d' inputs.sh\nsed -i '/=\"\"/d' inputs.sh\n# Add export to all lines\nsed -i 's/^/export /' inputs.sh\ncat inputs.sh\n"]},"path":"/jobs/preprocess/steps/1"},{"name":"Controller Preprocessing","run":"set -euo pipefail\nset -x\n# The login node is the one with internet: bootstrap Spack, record its\n# site externals and register the build cache here, once, before\n# anything is submitted. The inspection job needs this Spack to exist\n# so it can report `spack arch -t`.\ncp inputs.sh controller-${PW_JOB_ID}.sh\ncat \"workflows/spack-builder/app/controller.sh\" \u003e\u003e controller-${PW_JOB_ID}.sh\nbash controller-${PW_JOB_ID}.sh\n","path":"/jobs/preprocess/steps/2"},{"id":"assemble","name":"Assemble scripts","run":"set -euo pipefail\nset -x\nset -a; . ./inputs.sh; set +a\n\n# All-or-nothing override policy. When it returns NEED_DETECT=0 the\n# fabric profile is already written and no worker is allocated.\nbash \"workflows/spack-builder/app/resolve-profile.sh\" \\\n     \"${PWD}/profile.decision\" \"${PWD}/fabric.env\"\n. \"${PWD}/profile.decision\"\necho \"NEED_DETECT=${NEED_DETECT}\" | tee -a $OUTPUTS\necho \"RUNDIR=${PWD}\" | tee -a $OUTPUTS\n\n# One run directory per submitted job. They must NOT share one:\n# script_submitter streams its script's output to run.${PW_JOB_ID}.out\n# in its rundir, and all three submissions of a run carry the same\n# PW_JOB_ID -- so a shared directory means the endpoint job truncates\n# the build log that explains the build. The scripts\n# themselves are unaffected: every path they use -- inputs.sh,\n# fabric.env, spack-env, app/ -- is absolute and still points here.\nmkdir -p \"${PWD}/detect\" \"${PWD}/build\" \"${PWD}/endpoint\" \"${PWD}/exec\"\necho \"DETECT_DIR=${PWD}/detect\" | tee -a $OUTPUTS\necho \"BUILD_DIR=${PWD}/build\" | tee -a $OUTPUTS\necho \"ENDPOINT_DIR=${PWD}/endpoint\" | tee -a $OUTPUTS\necho \"EXEC_DIR=${PWD}/exec\" | tee -a $OUTPUTS\n\n# script_submitter runs an existing script, so each one is inputs.sh\n# concatenated with its body. Note this puts the script in the run\n# directory, not in app/ -- which is why the scripts take their paths\n# from inputs.sh rather than from $BASH_SOURCE.\ncp inputs.sh detect-${PW_JOB_ID}.sh\ncat \"workflows/spack-builder/app/detect-fabric.sh\" \u003e\u003e detect-${PW_JOB_ID}.sh\necho \"DETECT_SCRIPT=${PWD}/detect-${PW_JOB_ID}.sh\" | tee -a $OUTPUTS\n\ncp inputs.sh build-${PW_JOB_ID}.sh\ncat \"workflows/spack-builder/app/build.sh\" \u003e\u003e build-${PW_JOB_ID}.sh\necho \"BUILD_SCRIPT=${PWD}/build-${PW_JOB_ID}.sh\" | tee -a $OUTPUTS\n\ncp inputs.sh exec-${PW_JOB_ID}.sh\ncat \"workflows/spack-builder/app/check-exec.sh\" \u003e\u003e exec-${PW_JOB_ID}.sh\necho \"EXEC_SCRIPT=${PWD}/exec-${PW_JOB_ID}.sh\" | tee -a $OUTPUTS\n\n# The placeholder endpoint. The trap wrapper is the one every service\n# workflow here uses: it runs cancel.sh once and then kills the process\n# group, which is what makes `pw endpoints delete` on teardown reliable.\ncp inputs.sh endpoint-${PW_JOB_ID}.sh\ncat \u003c\u003c'EOF' \u003e\u003e endpoint-${PW_JOB_ID}.sh\n\ncleanup() {\n    trap - EXIT INT TERM HUP QUIT USR1 USR2 PIPE\n    echo \"::notice::Cleaning up...\"\n    if [ -f cancel.sh ]; then\n        mv cancel.sh cancel.sh.submitted\n        echo \"echo Cleanup script was already executed\" \u003e cancel.sh\n        bash cancel.sh.submitted\n    fi\n    kill -- -$$\n}\n\ntrap cleanup EXIT INT TERM HUP QUIT USR1 USR2 PIPE\nEOF\ncat \"workflows/spack-builder/app/start-template.sh\" \u003e\u003e endpoint-${PW_JOB_ID}.sh\necho \"ENDPOINT_SCRIPT=${PWD}/endpoint-${PW_JOB_ID}.sh\" | tee -a $OUTPUTS\necho \"SKIP_CLEANUP_PATH=${PWD}/SKIP_CLEANUP\" | tee -a $OUTPUTS\n","path":"/jobs/preprocess/steps/3"}],"outputs":{"BUILD_DIR":{"${{":[{"src":" needs.preprocess.steps.assemble.outputs.BUILD_DIR ","tree":{"path":["preprocess","steps","assemble","outputs","BUILD_DIR"],"ref":"needs"}}]},"BUILD_SCRIPT":{"${{":[{"src":" needs.preprocess.steps.assemble.outputs.BUILD_SCRIPT ","tree":{"path":["preprocess","steps","assemble","outputs","BUILD_SCRIPT"],"ref":"needs"}}]},"DETECT_DIR":{"${{":[{"src":" needs.preprocess.steps.assemble.outputs.DETECT_DIR ","tree":{"path":["preprocess","steps","assemble","outputs","DETECT_DIR"],"ref":"needs"}}]},"DETECT_SCRIPT":{"${{":[{"src":" needs.preprocess.steps.assemble.outputs.DETECT_SCRIPT ","tree":{"path":["preprocess","steps","assemble","outputs","DETECT_SCRIPT"],"ref":"needs"}}]},"ENDPOINT_DIR":{"${{":[{"src":" needs.preprocess.steps.assemble.outputs.ENDPOINT_DIR ","tree":{"path":["preprocess","steps","assemble","outputs","ENDPOINT_DIR"],"ref":"needs"}}]},"ENDPOINT_SCRIPT":{"${{":[{"src":" needs.preprocess.steps.assemble.outputs.ENDPOINT_SCRIPT ","tree":{"path":["preprocess","steps","assemble","outputs","ENDPOINT_SCRIPT"],"ref":"needs"}}]},"EXEC_DIR":{"${{":[{"src":" needs.preprocess.steps.assemble.outputs.EXEC_DIR ","tree":{"path":["preprocess","steps","assemble","outputs","EXEC_DIR"],"ref":"needs"}}]},"EXEC_SCRIPT":{"${{":[{"src":" needs.preprocess.steps.assemble.outputs.EXEC_SCRIPT ","tree":{"path":["preprocess","steps","assemble","outputs","EXEC_SCRIPT"],"ref":"needs"}}]},"NEED_DETECT":{"${{":[{"src":" needs.preprocess.steps.assemble.outputs.NEED_DETECT ","tree":{"path":["preprocess","steps","assemble","outputs","NEED_DETECT"],"ref":"needs"}}]},"RUNDIR":{"${{":[{"src":" needs.preprocess.steps.assemble.outputs.RUNDIR ","tree":{"path":["preprocess","steps","assemble","outputs","RUNDIR"],"ref":"needs"}}]},"SKIP_CLEANUP_PATH":{"${{":[{"src":" needs.preprocess.steps.assemble.outputs.SKIP_CLEANUP_PATH ","tree":{"path":["preprocess","steps","assemble","outputs","SKIP_CLEANUP_PATH"],"ref":"needs"}}]}},"path":"/jobs/preproc